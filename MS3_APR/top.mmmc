## double check the following relative paths -- all TSMC files are
## copied flat into this same folder, no subfolders.

create_library_set -name tc -timing {./tcbn65gplustc.lib}

create_constraint_mode -name sdc -sdc_files {./shiftregister.sdc}

## RC corner: TLU+ extraction file (Synopsys-format parasitics; Innovus
## supports reading TLU+ directly as a documented cross-vendor
## accommodation, even though Cadence's native format is QRC).
create_rc_corner -name rc_typ -qx_tech_file ./crn65lp_1p09m+alrdl_6x1z1u_typical.tluplus -T 25

create_delay_corner -name delay_tc -library_set {tc} -rc_corner {rc_typ}
create_analysis_view -name view_tc -constraint_mode {sdc} -delay_corner {delay_tc}
set_analysis_view -setup {view_tc} -hold {view_tc}
