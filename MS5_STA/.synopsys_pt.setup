#=====================================================================
#   PrimeTime library setup — TSMC 65nm (tcbn65gplustc)
#
#   Automatically sourced by pt_shell on startup when this file is
#   present in the current working directory. Defines which standard
#   cell library pt_shell is allowed to link the post-route netlist
#   against, and where to find it on disk.
#
#   The library file itself lives in ./lib (copied in alongside this
#   project, not referenced from any other location) so this project
#   folder is self-contained and works on any account.
#=====================================================================

# Target technology library
set TECH_LIB  tcbn65gplustc
set TECH_FILE ${TECH_LIB}.db

# Search path: where pt_shell looks for library files referenced by
# short name.
set search_path "."
lappend search_path "./lib"

# Target / link library
set target_library "$TECH_FILE"
# The first entry in link_library is the default library for new cells;
# the trailing "*" also allows resolution against anything already loaded.
set link_library "$target_library *"

set verbose_messages false
