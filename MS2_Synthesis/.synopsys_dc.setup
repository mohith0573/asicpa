#=====================================================================
#   Design Compiler library setup — TSMC 65nm (tcbn65gplustc)
#
#   Automatically sourced by dc_shell on startup when this file is
#   present in the current working directory. Defines which standard
#   cell library dc_shell is allowed to synthesize against, and where
#   to find it on disk.
#=====================================================================

# Target technology library
set TECH_LIB  tcbn65gplustc
set TECH_FILE ${TECH_LIB}.db

# Search path: where dc_shell looks for library files referenced by
# short name. EDIT the second entry if the library is extracted
# somewhere other than this path.
set search_path "."
lappend search_path "/home/mthatikonda/tsmc65_work/FE_nldm/TSMCHOME/digital/Front_End/timing_power_noise/NLDM/tcbn65gplus_200a"

# Target / link library
set target_library "$TECH_FILE"
# The first entry in link_library is the default library for new cells;
# the trailing "*" also allows resolution against anything already loaded.
set link_library "$target_library *"

set verbose_messages false

# Disable auxiliary log files
set view_command_log_file /dev/null
if {$dc_shell_mode == "default"} {
    set command_log_file /dev/null
} else {
    set sh_command_log_file /dev/null
}

# Work library location
file mkdir work
define_design_lib WORK -path {./work}
